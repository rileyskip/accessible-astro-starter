---
import Layout from '@layouts/Layout.astro'
import SiteHeader from '@components/SiteHeader.astro'
import { siteConfig } from '@config/site'
---

<Layout
  title={`Privacy Policy | ${siteConfig.name}`}
  description="Privacy policy for this portfolio site."
  showFooterCta={false}
  noindex={true}
>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="legal-page">
    <SiteHeader />

    <main id="main-content" class="legal-main">
      <header class="legal-header">
        <h1>Privacy Policy</h1>
        <p class="legal-intro">
          This policy describes what information may be collected when you visit {siteConfig.name}'s
          portfolio site and how that information is used.
        </p>
      </header>

      <article class="legal-content">
        <section>
          <h2>Information We Collect</h2>
          <p>
            This site may use optional analytics tools if you opt in through the cookie consent banner.
            Essential preferences such as theme and consent choices are stored locally in your browser.
          </p>
        </section>

        <section>
          <h2>How We Use Information</h2>
          <p>
            Information is used to improve site performance, understand aggregate usage, and remember
            accessibility-related preferences such as theme selection.
          </p>
        </section>

        <section>
          <h2>Contact</h2>
          <p>
            Questions about this policy can be sent to{' '}
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
          </p>
        </section>
      </article>
    </main>
  </div>
</Layout>

<style>
  .legal-page {
    width: min(calc(100% - 3rem), 62rem);
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }

  .legal-main {
    padding-top: 4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    letter-spacing: -0.04em;
  }

  .legal-intro,
  .legal-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--muted-foreground);
  }

  .legal-intro {
    margin-top: 1rem;
  }

  .legal-content {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .legal-content h2 {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    color: var(--foreground);
  }

  @media (max-width: 720px) {
    .legal-page {
      width: min(calc(100% - 1.5rem), 62rem);
    }
  }
</style>
