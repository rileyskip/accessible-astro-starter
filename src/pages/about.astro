---
import Layout from '@layouts/Layout.astro'
import SiteHeader from '@components/SiteHeader.astro'
import { siteConfig } from '@config/site'
import { contact, toolGroups, experience, education } from '@data/resume'
---

<Layout
  title={`About | ${siteConfig.name}`}
  description="Web developer and UX designer building accessible digital products with React, Drupal, Figma, and WCAG-aligned design systems."
>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="page">
    <SiteHeader />

    <main id="main-content">
      <section class="hero">
        <p class="eyebrow">About</p>
        <h1 class="display-title">Web developer focused on accessible, user-centered product work.</h1>
        <p class="hero-text">
          I build and design digital experiences across Drupal, React, and design systems — with a
          strong emphasis on accessibility, clear information architecture, and interfaces that hold
          up for real users.
        </p>
        <ul class="contact-list" aria-label="Contact information">
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li>
            <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<i class="fa-brands fa-linkedin"></i></a>
          </li>
        </ul>
        <div class="hero-actions">
          <a class="pill-link" href="/work">View my work</a>
          <a class="pill-link pill-link-secondary" href="/contact">Get in touch</a>
        </div>
      </section>

      <section class="editorial-section" aria-labelledby="tools-heading">
        <div class="section-rail">
          <p class="section-kicker">Tools</p>
        </div>
        <div class="story-block">
          <h2 id="tools-heading" class="sr-only">Skills and tools</h2>
          <div class="tools-grid">
            {
              toolGroups.map((group) => (
                <div class="tool-card">
                  <h3>{group.category}</h3>
                  <p>{group.items.join(', ')}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="editorial-section" aria-labelledby="experience-heading">
        <div class="section-rail">
          <p class="section-kicker">Experience</p>
        </div>
        <div class="story-block">
          <h2 id="experience-heading" class="sr-only">Professional experience</h2>
          {
            experience.map((entry) => (
              <article class="experience-entry">
                <div class="experience-heading">
                  <h3>{entry.title}</h3>
                  <p class="experience-meta">
                    {entry.company} • {entry.period}
                  </p>
                </div>
                <ul>
                  {entry.bullets.map((bullet) => <li>{bullet}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="editorial-section" aria-labelledby="education-heading">
        <div class="section-rail">
          <p class="section-kicker">Education</p>
        </div>
        <div class="story-block">
          <h2 id="education-heading" class="sr-only">Education</h2>
          {
            education.map((entry) => (
              <article class="education-entry">
                <h3>{entry.degree}</h3>
                <p class="experience-meta">
                  {entry.school} • {entry.period}
                </p>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    width: min(calc(100% - 3rem), 78rem);
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }

  .hero {
    padding: 5rem 0 3rem;
  }

  .eyebrow,
  .section-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--brand-orange);
  }

  .hero-text {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-list a {
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent-link);
    text-decoration: none;
  }

  .contact-list a:hover,
  .contact-list a:focus-visible {
    text-decoration: underline;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .pill-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--brand-blue);
    border-radius: 999px;
    background: var(--brand-blue);
    color: var(--brand-cream);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 120ms ease,
      background-color 120ms ease;
  }

  .pill-link-secondary {
    background: transparent;
    color: var(--foreground);
    border-color: var(--control-border);
  }

  .pill-link:hover,
  .pill-link:focus-visible {
    transform: translateY(-1px);
  }

  .pill-link-secondary:hover,
  .pill-link-secondary:focus-visible {
    background: var(--muted);
    border-color: var(--border-strong);
  }

  .editorial-section {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 2rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }

  .story-block {
    display: grid;
    gap: 1.5rem;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .tool-card {
    padding: 1.1rem 1.2rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 1rem;
  }

  .tool-card h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tool-card p {
    margin: 0.45rem 0 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .experience-entry,
  .education-entry {
    display: grid;
    gap: 0.75rem;
  }

  .experience-entry h3,
  .education-entry h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .experience-meta {
    margin: 0.35rem 0 0;
    font-size: 0.98rem;
    color: var(--muted-foreground);
  }

  .experience-entry ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
  }

  .experience-entry li {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }

  @media (max-width: 900px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .page {
      width: min(calc(100% - 1.5rem), 78rem);
      padding-top: 1rem;
    }

    .hero {
      padding: 4rem 0 3rem;
    }

    .editorial-section {
      grid-template-columns: 1fr;
    }
  }
</style>
