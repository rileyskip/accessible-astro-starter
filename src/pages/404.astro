---
import Layout from '@layouts/Layout.astro'
import SiteHeader from '@components/SiteHeader.astro'
import { siteConfig } from '@config/site'
---

<Layout title={`Page not found | ${siteConfig.name}`} noindex={true} showFooterCta={false}>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="page">
    <SiteHeader />

    <main id="main-content" class="not-found">
      <p class="eyebrow">404</p>
      <h1 class="display-title">This page doesn't exist.</h1>
      <p class="hero-text">The page may have moved, or the URL might be incorrect.</p>
      <a class="home-link" href="/">Return home</a>
    </main>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    width: min(calc(100% - 3rem), 78rem);
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }

  .not-found {
    padding: 6rem 0 4rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .hero-text {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 1.5rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--control-border);
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    transition:
      transform 120ms ease,
      border-color 120ms ease,
      background-color 120ms ease;
  }

  .home-link:hover,
  .home-link:focus-visible {
    transform: translateY(-1px);
    background: var(--muted);
    border-color: var(--border-strong);
  }

  @media (max-width: 720px) {
    .page {
      width: min(calc(100% - 1.5rem), 78rem);
    }
  }
</style>
