---
import Layout from '@layouts/Layout.astro'
import SiteHeader from '@components/SiteHeader.astro'
import { siteConfig } from '@config/site'
import { getProjects } from '@lib/projects'

const projects = await getProjects({ featuredOnly: true })
---

<Layout title={siteConfig.title} description={siteConfig.description}>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="page">
    <SiteHeader />

    <main id="main-content">
      <section class="hero" id="top">
        <div class="hero-copy">
          <p class="hero-eyebrow">Selected work</p>
          <p class="hero-text">
            I turn messy user problems into products people actually want to use — with accessible
            design, clear information architecture, and interfaces built to earn trust.
          </p>
        </div>
      </section>

      <section class="projects" id="work" aria-labelledby="selected-work-heading">
        <h2 id="selected-work-heading" class="sr-only">Selected work</h2>
        <div class="projects-grid">
          {
            projects.map((project) => (
              <article class={`project-card ${project.background}`}>
                <div class="project-header">
                  <p class="project-name">{project.name}</p>
                </div>

                <div class="project-copy">
                  <p class="project-label">The challenge</p>
                  <p class="project-problem">{project.problem}</p>
                  <p class="project-label">What I delivered</p>
                  <h3 class="project-title">{project.solution}</h3>
                </div>

                <div class:list={['project-visual', project.imageCompact && 'project-visual-compact']}>
                  <img
                    class:list={[
                      'project-preview-image',
                      project.imageCompact && 'project-preview-image--compact',
                    ]}
                    src={project.image}
                    alt={project.alt}
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="540"
                  />
                </div>

                <a class="project-button" href={project.href}>
                  Explore this project
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    width: min(calc(100% - 3rem), 78rem);
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }

  .hero {
    padding: 5rem 0 3rem;
  }

  .hero-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-orange);
  }

  .hero-text {
    max-width: 40rem;
    margin: 0.75rem 0 0;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .project-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 1.25rem;
    height: 100%;
    padding: 1.5rem;
    border-radius: 1.35rem;
    overflow: hidden;
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .project-card.brand-blue {
    background: #214fc4;
    color: #fff7ef;
  }

  .project-card.brand-cream {
    background: #fff7ef;
    color: #1a2d5c;
    border: 1px solid #e3e3ff;
  }

  .project-card.brand-orange {
    background: #ff5100;
    color: #fff7ef;
  }

  .project-card.brand-lavender {
    background: #e3e3ff;
    color: #1a2d5c;
  }

  .project-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .project-copy {
    display: grid;
    gap: 0.35rem;
  }

  .project-label {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .project-problem {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.5;
    opacity: 0.9;
  }

  .project-title {
    margin: 0;
    font-size: clamp(1.2rem, 1.6vw, 1.55rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .project-visual {
    position: relative;
    min-height: 14rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .project-visual-compact {
    min-height: auto;
    padding: 0.5rem 0;
  }

  .project-preview-image {
    width: 100%;
    height: 14rem;
    object-fit: cover;
    object-position: center top;
    border-radius: 1rem;
    box-shadow: var(--shadow-medium);
  }

  .project-preview-image--compact {
    width: min(62%, 220px);
    height: auto;
    max-height: 18rem;
    object-fit: contain;
    box-shadow: var(--shadow-soft);
  }

  .project-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.85rem 1.2rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--background) 12%, transparent);
    color: inherit;
    font-size: 0.98rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 120ms ease,
      background-color 120ms ease;
    justify-self: start;
  }

  .project-card.brand-cream .project-button,
  .project-card.brand-lavender .project-button {
    background: var(--brand-blue);
    border-color: var(--brand-blue);
    color: var(--brand-cream);
  }

  .project-button:hover,
  .project-button:focus-visible {
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--background) 22%, transparent);
  }

  .project-card.brand-cream .project-button:hover,
  .project-card.brand-cream .project-button:focus-visible,
  .project-card.brand-lavender .project-button:hover,
  .project-card.brand-lavender .project-button:focus-visible {
    background: color-mix(in srgb, var(--brand-blue) 88%, #000 12%);
  }

  @media (max-width: 980px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .page {
      width: min(calc(100% - 1.5rem), 78rem);
      padding-top: 1rem;
    }

    .hero {
      padding: 3rem 0 2rem;
    }

    .project-preview-image--compact {
      width: min(72%, 200px);
    }
  }
</style>
