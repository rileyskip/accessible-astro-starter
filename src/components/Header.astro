---
import { Icon } from 'astro-icon/components'
import { SkipLink } from 'accessible-astro-components'
---

<header class="site-header sticky top-0 z-50">
  <SkipLink />
  <div class="header-glow"></div>
  <div class="container">
    <div class="header-content flex items-center justify-between py-3 md:py-5">
      <a href="/" class="logo-link text-2xl font-bold">
        <span class="logo-bracket">&lt;</span>
        <span class="logo-text">Riley Skipper</span>
        <span class="logo-bracket">/&gt;</span>
      </a>
      
      <div class="flex items-center gap-2 sm:gap-3 buttons-container">
        <!-- Hamburger Menu Button (mobile only) -->
        <button
          id="mobile-menu-toggle"
          class="mobile-menu-toggle md:hidden"
          aria-label="Open mobile menu"
          aria-expanded="false"
        >
          <Icon name="lucide:menu" class="h-6 w-6" />
        </button>

        <!-- Desktop Navigation -->
        <nav class="hidden md:block">
          <ul class="nav-menu flex items-center gap-2">
            <li>
              <a href="/" class="nav-link">Home</a>
            </li>
            <li>
              <a href="/about" class="nav-link">About</a>
            </li>
            <li>
              <a href="/portfolio/" class="nav-link">Portfolio</a>
            </li>
            <li>
              <a href="/contact" class="nav-link">Contact</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Backdrop -->
  <div id="mobile-menu-backdrop" class="mobile-menu-backdrop"></div>

  <!-- Mobile Menu - Hidden by default -->
  <div id="mobile-menu" class="mobile-menu">
    <!-- Close Button -->
    <button
      id="mobile-menu-close"
      class="mobile-menu-close"
      aria-label="Close menu"
    >
      <Icon name="lucide:x" class="h-6 w-6" />
    </button>
    
    <!-- Navigation Links -->
    <nav id="mobile-nav-links">
      <ul class="mobile-nav-menu">
        <li>
          <a href="/" class="mobile-nav-link">Home</a>
        </li>
        <li>
          <a href="/about" class="mobile-nav-link">About</a>
        </li>
        <li>
          <a href="/portfolio/" class="mobile-nav-link">Portfolio</a>
        </li>
        <li>
          <a href="/contact" class="mobile-nav-link">Contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  /* Header Base Styles */
  .site-header {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.98) 0%, rgba(0, 0, 0, 0.95) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 2px solid transparent;
    border-image: linear-gradient(90deg, transparent, #60A5FA, transparent) 1;
    transition: all 0.3s ease;
    position: relative;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);

    @media (max-width: 640px) {
      .container {
        padding-left: 1rem;
        padding-right: 1rem;
      }
    }

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(96, 165, 250, 0.1), transparent);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    &:hover::before {
      opacity: 1;
    }
  }

  .header-glow {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #60A5FA, #3B82F6, #60A5FA, transparent);
    animation: shimmer 3s ease-in-out infinite;
    box-shadow: 0 0 10px rgba(96, 165, 250, 0.5);
  }

  @keyframes shimmer {
    0%, 100% {
      opacity: 0.3;
      transform: translateX(-100%);
    }
    50% {
      opacity: 1;
      transform: translateX(100%);
    }
  }

  .header-content {
    position: relative;
    z-index: 10;
    max-width: 100%;
    overflow: visible;
  }

  .buttons-container {
    flex-shrink: 0;
    
    @media (max-width: 374px) {
      gap: 0.5rem !important;
    }
  }

  .logo-link {
    transition: all 0.3s ease;
    color: white;
    text-decoration: none;
    font-weight: 700;
    flex-shrink: 1;
    min-width: 0;

    @media (max-width: 374px) {
      font-size: 1.25rem !important;
    }
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 1.25rem;

    @media (min-width: 768px) {
      font-size: 1.5rem;
    }

    &:hover {
      transform: translateY(-2px);
      
      .logo-text {
        background: linear-gradient(135deg, #60A5FA, #3B82F6, #2563EB);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .logo-bracket {
        color: #60A5FA;
        animation: bracket-pulse 0.6s ease;
      }
    }
  }

  .logo-bracket {
    color: #60A5FA;
    font-weight: 900;
    font-size: 1.5rem;
    transition: all 0.3s ease;
  }

  .logo-text {
    transition: all 0.3s ease;
  }

  @keyframes bracket-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
  }

  /* Navigation Menu Styles */
  .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 0.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;

    @media (min-width: 768px) {
      padding: 0.5rem 1rem;
      font-size: 1rem;
    }

    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 0;
      background: linear-gradient(90deg, transparent, #60A5FA, #3B82F6, #60A5FA, transparent);
      transition: height 0.3s ease;
      box-shadow: 0 0 10px rgba(96, 165, 250, 0.6);
    }

    span {
      position: relative;
      z-index: 1;
    }

    &:hover {
      color: #60A5FA;
      transform: translateY(-2px) scale(1.05);
      text-shadow: 0 0 15px rgba(96, 165, 250, 0.8),
                   0 0 30px rgba(96, 165, 250, 0.4);

      &::after {
        height: 3px;
      }
    }
  }

  /* Mobile Menu Toggle Button */
  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0.625rem;
    color: white;
    background: transparent;
    border: 2px solid #60A5FA;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    z-index: 110;
    flex-shrink: 0;

    @media (min-width: 768px) {
      display: none !important;
    }

    &:hover {
      background: rgba(96, 165, 250, 0.1);
      border-color: #60A5FA;
      transform: scale(1.05);
    }

    &:focus-visible {
      outline: 2px solid #3B82F6;
      outline-offset: 2px;
    }

    &:active {
      transform: scale(0.95);
    }

    svg {
      transition: all 0.3s ease;
      flex-shrink: 0;
    }
  }

  /* Mobile Menu Backdrop */
  .mobile-menu-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 99;

    @media (min-width: 768px) {
      display: none !important;
    }
  }

  /* Mobile Menu */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    width: 85%;
    max-width: 320px;
    height: 100vh;
    height: 100dvh;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.98) 0%, rgba(0, 0, 0, 0.95) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.5);
    z-index: 100;
    padding-top: max(5rem, env(safe-area-inset-top, 5rem));
    padding-bottom: env(safe-area-inset-bottom, 0);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;

    @media (min-width: 768px) {
      display: none !important;
    }

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(96, 165, 250, 0.05), transparent);
      pointer-events: none;
    }

    @media (max-width: 374px) {
      width: 90%;
    }
  }

  /* Mobile Menu Close Button */
  .mobile-menu-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(96, 165, 250, 0.1);
    border: 2px solid rgba(96, 165, 250, 0.3);
    border-radius: 0.5rem;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 101;

    &:hover {
      background: rgba(96, 165, 250, 0.2);
      border-color: #60A5FA;
      transform: rotate(90deg) scale(1.1);
    }

    &:active {
      transform: rotate(90deg) scale(0.95);
    }

    &:focus-visible {
      outline: 2px solid #3B82F6;
      outline-offset: 2px;
    }
  }

  .mobile-nav-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 1rem 1.5rem;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.5;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: transparent;
    border-left: 3px solid transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: rgba(96, 165, 250, 0.2);

    &:hover {
      background: rgba(96, 165, 250, 0.1);
      border-left-color: #60A5FA;
      color: #60A5FA;
      padding-left: 2rem;
    }

    &:active {
      background: rgba(96, 165, 250, 0.2);
      transform: scale(0.98);
    }

    &:focus-visible {
      outline: 2px solid #3B82F6;
      outline-offset: -2px;
    }
  }
</style>

<script>
  // Mobile Menu Toggle
  function initMobileMenu() {
    const menuToggle = document.getElementById('mobile-menu-toggle')
    const mobileMenu = document.getElementById('mobile-menu')
    const backdrop = document.getElementById('mobile-menu-backdrop')

    if (!menuToggle || !mobileMenu || !backdrop) return

    // Clone the button to remove old event listeners
    const newToggle = menuToggle.cloneNode(true) as HTMLElement
    if (menuToggle.parentNode) {
      menuToggle.parentNode.replaceChild(newToggle, menuToggle)
    }

    // Ensure menu and backdrop start closed
    mobileMenu.style.display = 'none'
    backdrop.style.display = 'none'

    // Toggle menu function
    function toggleMenu() {
      if (!mobileMenu || !backdrop) return
      
      if (mobileMenu.style.display === 'block') {
        // Close menu
        mobileMenu.style.display = 'none'
        backdrop.style.display = 'none'
        newToggle.setAttribute('aria-expanded', 'false')
        newToggle.setAttribute('aria-label', 'Open mobile menu')
        newToggle.style.display = ''
        document.body.style.overflow = ''
      } else {
        // Open menu
        mobileMenu.style.display = 'block'
        backdrop.style.display = 'block'
        newToggle.setAttribute('aria-expanded', 'true')
        newToggle.setAttribute('aria-label', 'Close mobile menu')
        newToggle.style.display = 'none'
        document.body.style.overflow = 'hidden'
      }
    }

    // Menu toggle click
    newToggle.addEventListener('click', toggleMenu)

    // Close button inside menu
    const closeButton = document.getElementById('mobile-menu-close')
    if (closeButton && closeButton.parentNode) {
      const newCloseButton = closeButton.cloneNode(true) as HTMLElement
      closeButton.parentNode.replaceChild(newCloseButton, closeButton)
      newCloseButton.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        toggleMenu()
      })
    }

    // Close menu when clicking backdrop
    backdrop.addEventListener('click', () => {
      if (mobileMenu.style.display === 'block') {
        toggleMenu()
      }
    })

    // Close menu when clicking a link
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link')
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (mobileMenu.style.display === 'block') {
          toggleMenu()
        }
      })
    })

    // Close menu on escape key
    const escapeHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && mobileMenu?.style.display === 'block') {
        toggleMenu()
      }
    }
    
    document.removeEventListener('keydown', escapeHandler)
    document.addEventListener('keydown', escapeHandler)
  }

  // Run mobile menu initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu)
  } else {
    initMobileMenu()
  }

  // Re-run on view transitions
  document.addEventListener('astro:page-load', initMobileMenu)
  document.addEventListener('astro:after-swap', initMobileMenu)
</script>
